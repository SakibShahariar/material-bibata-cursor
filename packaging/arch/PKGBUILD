# Maintainer: SakibShahariar
pkgname=material-bibata-cursor
pkgver=1.5.0
pkgrel=1
pkgdesc='Material Design 3 Bibata cursor themes for Xcursor, Hyprcursor, and SVG'
arch=('any')
url='https://github.com/SakibShahariar/material-bibata-cursor'
license=('MIT' 'GPL3')
depends=('hicolor-icon-theme')
makedepends=('git' 'python>=3.12' 'librsvg' 'xorg-xcursorgen' 'licenses')
_upstream_commit='f4ccfe8abb63fddc7b3ce51a866fd8378395cb3d'
source=(
  "${pkgname}::git+https://github.com/SakibShahariar/material-bibata-cursor.git#tag=v${pkgver}"
  "bibata_cursor::git+https://github.com/rtgiskard/bibata_cursor.git#commit=${_upstream_commit}"
)
sha256sums=('SKIP' 'SKIP')

prepare() {
  # The Linux builder consumes the pinned upstream checkout from this source
  # package. It verifies the exact commit and avoids network access in package().
  cp -a "$srcdir/bibata_cursor" "$srcdir/$pkgname/scripts/bibata_cursor"
}

package() {
  cd "$srcdir/$pkgname"
  python scripts/build_linux.py \
    --jobs 2 \
    --install-dir "$pkgdir/usr/share/icons" \
    --scalable-dir "$pkgdir/usr/share/icons"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 /usr/share/licenses/common/GPL3 "$pkgdir/usr/share/licenses/$pkgname/GPL3"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
